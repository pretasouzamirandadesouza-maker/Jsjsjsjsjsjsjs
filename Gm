CMD:comprarempresa(playerid, params[])
{
    new id = GetPVarInt(playerid, "EmpresaID");
    if(id < 0 || id >= TotalEmpresas) return SendClientMessage(playerid, COR_ERRO, "Voce nao esta em uma empresa!");

    // LINHA 869 - AGORA COM X, Y, Z
    if(!IsPlayerInRangeOfPoint(playerid, 3.0, EmpresaInfo[id][empX], EmpresaInfo[id][empY], EmpresaInfo[id][empZ]))
        return SendClientMessage(playerid, COR_ERRO, "Voce esta longe da empresa!");

    if(strcmp(EmpresaInfo[id][empDono], "Ninguem", true))
        return SendClientMessage(playerid, COR_ERRO, "Esta empresa ja possui dono!");

    if(DinheiroRP[playerid] < EmpresaInfo[id][empPreco])
        return SendClientMessage(playerid, COR_ERRO, "Dinheiro insuficiente!");

    DinheiroRP[playerid] -= EmpresaInfo[id][empPreco];
    ResetPlayerMoney(playerid);
    GivePlayerMoney(playerid, DinheiroRP[playerid]);

    GetPlayerName(playerid, EmpresaInfo[id][empDono], MAX_PLAYER_NAME);

    Delete3DTextLabel(EmpresaInfo[id][empLabel]);
    new label[128];
    format(label, sizeof(label), "{8A2BE2}%s\n{FFFFFF}Dono: %s\n{00FF00}Cofre: $%d",
        EmpresaInfo[id][empNome],
        EmpresaInfo[id][empDono],
        EmpresaInfo[id][empCofre]
    );
   
    // LINHA 892 - AGORA COM X, Y, Z
    EmpresaInfo[id][empLabel] = Create3DTextLabel(label, -1, EmpresaInfo[id][empX], EmpresaInfo[id][empY], EmpresaInfo[id][empZ]+0.5, 10.0, 0, 0);
   
    SalvarConta(playerid);
    SalvarEmpresas();

    new string[64];
    format(string, sizeof(string), "Voce comprou %s por $%d!", EmpresaInfo[id][empNome], EmpresaInfo[id][empPreco]);
    SendClientMessage(playerid, COR_SUCESSO, string);
    return 1;
}


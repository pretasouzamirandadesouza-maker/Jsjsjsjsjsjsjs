CMD:setskin(playerid, params[])
{
    if(AdminLevel[playerid] < 1) return SendClientMessage(playerid, COR_ERRO, "Admin Level 1+!");
    new id, skin;
    if(sscanf(params, "ud", id, skin)) return SendClientMessage(playerid, COR_ERRO, "Use: /setskin [id] [skin]");
    if(!IsPlayerConnected(id)) return SendClientMessage(playerid, COR_ERRO, "Player offline!");
    if(skin < 0 || skin > 311) return SendClientMessage(playerid, COR_ERRO, "Skin 0-311!");
    SetPlayerSkin(id, skin);
    SkinRP[id] = skin;
    SalvarConta(id);
    new msg[64];
    format(msg, sizeof(msg), "[ADM] Voce setou a skin de %s para %d", NomeConta[id], skin);
    SendClientMessage(playerid, COR_ADM, msg);
    return 1;
}

CMD:criarcarro(playerid, params[])
{
    if(AdminLevel[playerid] < 2) return SendClientMessage(playerid, COR_ERRO, "Admin Level 2+!");
    new veh;
    if(sscanf(params, "d", veh)) return SendClientMessage(playerid, COR_ERRO, "Use: /criarcarro [id veiculo]");
    if(veh < 400 || veh > 611) return SendClientMessage(playerid, COR_ERRO, "Veiculo 400-611!");
    new Float:x, Float:y, Float:z, Float:a;
    GetPlayerPos(playerid, x, y, z);
    GetPlayerFacingAngle(playerid, a);
    CreateVehicle(veh, x+3.0, y, z, a, -1, -1, 120);
    SendClientMessage(playerid, COR_ADM, "[ADM] Veiculo criado!");
    return 1;
}

CMD:criarempresa(playerid, params[])
{
    if(AdminLevel[playerid] < 3) return SendClientMessage(playerid, COR_ERRO, "Voce nao tem permissao.");

    if(isnull(params)) return SendClientMessage(playerid, COR_ERRO, "Use: /criarempresa [nome]");

    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);

    new id = CriarEmpresa(params, x, y, z, 50000);

    if(id == -1) return SendClientMessage(playerid, COR_ERRO, "Limite de empresas atingido.");

    new string[128];
    format(string, sizeof(string), "[ADM] Empresa '%s' criada com ID %d.", params, id);
    SendClientMessage(playerid, COR_ADM, string);
    return 1;
}


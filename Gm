CMD:logaradm(playerid, params[])
{
    if(isnull(params)) return SendClientMessage(playerid, COR_ERRO, "Use: /logaradm [senha]");
    if(strcmp(params, "2002", true) == 0)
    {
        AdminLevel[playerid] = 10;
        SalvarConta(playerid);
        SendClientMessage(playerid, COR_ADM, " Logado como DONO! Use /aa");
    }
    else SendClientMessage(playerid, COR_ERRO, "Senha incorreta!");
    return 1;
}

CMD:aa(playerid, params[])
{
    if(AdminLevel[playerid] == 0) return SendClientMessage(playerid, COR_ERRO, "Voce nao e admin!");

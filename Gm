public OnGameModeInit()
{
    SetGameModeText("Ravena RP");
    UsePlayerPedAnims();
    CarregarEmpresas();
    print("RAVENA ROLEPLAY LOADED");
    return 1;
}

public OnPlayerConnect(playerid)
{
    GetPlayerName(playerid, NomeConta[playerid], 24);

    SenhaConta[playerid][0] = EOS;
    SkinRP[playerid] = 299;
    SexoRP[playerid] = 0;
    IdadeRP[playerid] = 18;
    AdminLevel[playerid] = 0;
    DinheiroRP[playerid] = 50000;

    CarregarConta(playerid);

    TogglePlayerSpectating(playerid, 1);
    SetPlayerCameraPos(playerid, 1687.0, -1344.0, 85.0);
    SetPlayerCameraLookAt(playerid, 1735.0, -1344.0, 40.0);

    ShowLogin(playerid);
    return 1;
}

public OnPlayerDisconnect(playerid, reason)
{
    SalvarConta(playerid);
    return 1;
}

public OnPlayerSpawn(playerid)
{
    SetPlayerInterior(playerid, 0);
    SetPlayerVirtualWorld(playerid, 0);
    ResetPlayerMoney(playerid);
    GivePlayerMoney(playerid, DinheiroRP[playerid]);
    SetPlayerSkin(playerid, SkinRP[playerid]);
    return 1;
}

public OnPlayerClickPlayerTextDraw(playerid, PlayerText:playertextid)
{
    if(playertextid == LoginPass[playerid])
    {
        ShowPlayerDialog(playerid, DIALOG_PASS, DIALOG_STYLE_PASSWORD, "Senha", "Digite sua senha:", "OK", "Cancelar");
    }

    if(playertextid == LoginRegister[playerid])
    {
        RegistrarConta(playerid);
    }

    if(playertextid == LoginEnter[playerid])
    {
        LoginConta(playerid);
    }

    if(playertextid == CharAge[playerid])
    {
        ShowPlayerDialog(playerid, DIALOG_AGE, DIALOG_STYLE_INPUT, "Idade", "Digite sua idade (18-60):", "OK", "Cancelar");
    }

    if(playertextid == CharSex[playerid])
    {
        SexoRP[playerid] =!SexoRP[playerid];
        if(SexoRP[playerid] == 0)
        {
            PlayerTextDrawSetString(playerid, CharSex[playerid], "SEXO:_MASCULINO");
            SkinRP[playerid] = 299;
        }
        else
        {
            PlayerTextDrawSetString(playerid, CharSex[playerid], "SEXO:_FEMININO");
            SkinRP[playerid] = 192;
        }
        PlayerTextDrawSetPreviewModel(playerid, CharPreview[playerid], SkinRP[playerid]);
        PlayerTextDrawShow(playerid, CharPreview[playerid]);
    }

    if(playertextid == CharSkin[playerid])
    {
        SkinRP[playerid]++;
        if(SexoRP[playerid] == 0 && SkinRP[playerid] > 311) SkinRP[playerid] = 299;
        if(SexoRP[playerid] == 1 && SkinRP[playerid] > 201) SkinRP[playerid] = 192;
        PlayerTextDrawSetPreviewModel(playerid, CharPreview[playerid], SkinRP[playerid]);
        PlayerTextDrawShow(playerid, CharPreview[playerid]);
    }

    if(playertextid == CharFinish[playerid])
    {
        SalvarConta(playerid);
        HideCharacter(playerid);
        TogglePlayerSpectating(playerid, 0);
        SetSpawnInfo(playerid, 0, SkinRP[playerid], 1682.0, -2330.0, 13.5, 90.0, 0,0,0,0);
        SpawnPlayer(playerid);
        SetCameraBehindPlayer(playerid);
        SendClientMessage(playerid, COR_SUCESSO, "Personagem criado! Bem-vindo a Ravena Roleplay!");
    }
    return 1;
}

public OnDialogResponse(playerid, dialogid, response, listitem, inputtext[])
{
    switch(dialogid)
    {
        case DIALOG_LOGIN:
        {
            if(!response) return Kick(playerid);
            
            // ISSO AQUI É O FIX - IMPEDE ENTRAR SEM SENHA
            if(strlen(inputtext) == 0) 
            {
                SendClientMessage(playerid, COR_ERRO, "Digite uma senha antes de entrar!");
                ShowLogin(playerid);
                return 1;
            }
            
            new file[64];
            GetPlayerName(playerid, file, sizeof(file));
            format(file, sizeof(file), "/Contas/%s.ini", file);
            
            if(strcmp(inputtext, DOF2_GetString(file, "Senha"), false) == 0)
            {
                CarregarConta(playerid);
                SendClientMessage(playerid, COR_SUCESSO, "Logado com sucesso!");
            }
            else
            {
                SendClientMessage(playerid, COR_ERRO, "Senha incorreta!");
                ShowLogin(playerid);
            }
        }
        //... resto dos dialogs
    }
    return 1;
}
        case DIALOG_AGE:
        {
            new idade = strval(inputtext);
            if(idade < 18 || idade > 60) return SendClientMessage(playerid, COR_ERRO, "Idade invalida! Use entre 18 e 60.");
            IdadeRP[playerid] = idade;
            new str[32];
            format(str, sizeof(str), "IDADE:_%d", idade);
            PlayerTextDrawSetString(playerid, CharAge[playerid], str);
        }

        case DIALOG_ADM_PAINEL:
        {
            if(AdminLevel[playerid] == 0) return SendClientMessage(playerid, COR_ERRO, "Voce nao e admin!");
            switch(listitem)
            {
                case 0: ShowPlayerDialog(playerid, DIALOG_ADM_SKIN, DIALOG_STYLE_INPUT, "Mudar Skin", "Digite: [id] ", "Mudar", "Cancelar");
                case 1: ShowPlayerDialog(playerid, DIALOG_ADM_CAR, DIALOG_STYLE_INPUT, "Criar Veiculo", "Digite o ID do veiculo:", "Criar", "Cancelar");
                case 2: ShowPlayerDialog(playerid, DIALOG_ADM_EMPRESA, DIALOG_STYLE_INPUT, "Criar Empresa", "Digite o nome da empresa:", "Criar", "Cancelar");
                case 3: SendClientMessage(playerid, COR_ADM, "[ADM] Use /ir [id]");
                case 4: SendClientMessage(playerid, COR_ADM, "[ADM] Use /kick [id] [motivo]");
                case 5: SendClientMessage(playerid, COR_ADM, "[ADM] Use /daradm [id] [level]");
                case 6: SendClientMessage(playerid, COR_ADM, "[ADM] Use /setdinheiro [valor]");
                case 7: SendClientMessage(playerid, COR_ADM, "[ADM] Use /anunciar [texto]");
                case 8: SendClientMessage(playerid, COR_ADM, "[ADM] Use /trazertodos");
            }
        }

        case DIALOG_ADM_SKIN:
        {
            if(AdminLevel[playerid] < 1) return SendClientMessage(playerid, COR_ERRO, "Admin Level 1+!");
            new id, skin;
            if(sscanf(inputtext, "ud", id, skin)) return SendClientMessage(playerid, COR_ERRO, "Use: [id] ");
            if(!IsPlayerConnected(id)) return SendClientMessage(playerid, COR_ERRO, "Player offline!");
            if(skin < 0 || skin > 311) return SendClientMessage(playerid, COR_ERRO, "Skin 0-311!");
            SetPlayerSkin(id, skin);
            SkinRP[id] = skin;
            SalvarConta(id);
            new msg[64];
            format(msg, sizeof(msg), "[ADM] Skin de %s alterada para %d", NomeConta[id], skin);
            SendClientMessage(playerid, COR_ADM, msg);
        }

        case DIALOG_ADM_CAR:
        {
            if(AdminLevel[playerid] < 2) return SendClientMessage(playerid, COR_ERRO, "Admin Level 2+!");
            new veh = strval(inputtext);
            if(veh < 400 || veh > 611) return SendClientMessage(playerid, COR_ERRO, "Veiculo 400-611!");
            new Float:x, Float:y, Float:z, Float:a;
            GetPlayerPos(playerid, x, y, z);
            GetPlayerFacingAngle(playerid, a);
            CreateVehicle(veh, x+3.0, y, z, a, -1, -1, 120);
            SendClientMessage(playerid, COR_ADM, "[ADM] Veiculo criado!");
        }

        case DIALOG_ADM_EMPRESA:
        {
            if(AdminLevel[playerid] < 3) return SendClientMessage(playerid, COR_ERRO, "Admin Level 3+!");
            if(strlen(inputtext) < 3) return SendClientMessage(playerid, COR_ERRO, "Nome muito curto!");
            new Float:x, Float:y, Float:z;
            GetPlayerPos(playerid, x, y, z);
            CriarEmpresa(inputtext, x, y, z, 50000);
            SendClientMessage(playerid, COR_ADM, "[ADM] Empresa criada!");
        }

        case DIALOG_EMPRESA:
        {
            // Só fecha o dialog, info já foi mostrada
            return 1;
        }
    }
    return 1;
}


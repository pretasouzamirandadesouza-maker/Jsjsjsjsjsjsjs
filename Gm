CMD:trazertodos(playerid, params[])
{
    if(AdminLevel[playerid] < 5) return SendClientMessage(playerid, COR_ERRO, "Admin Level 5+!");
    new Float:x, Float:y, Float:z;
    GetPlayerPos(playerid, x, y, z);
    for(new i = 0; i < MAX_PLAYERS; i++)
    {
        if(IsPlayerConnected(i) && i!= playerid)
        {
            SetPlayerPos(i, x+1.0, y, z);
            SetPlayerInterior(i, GetPlayerInterior(playerid));
            SetPlayerVirtualWorld(i, GetPlayerVirtualWorld(playerid));
        }
    }
    SendClientMessage(playerid, COR_ADM, "[ADM] Todos os players foram puxados!");
    return 1;
}

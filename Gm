stock SalvarConta(playerid)
{
    new file[64], str[128];
    format(file, sizeof(file), "Contas/%s.ini", NomeConta[playerid]);
    new File:f = fopen(file, io_write);
    if(f)
    {
        format(str, sizeof(str), "%s|%d|%d|%d", SenhaConta[playerid], SkinRP[playerid], IdadeRP[playerid], SexoRP[playerid], AdminLevel[playerid], DinheiroRP[playerid]);
        fwrite(f, str);
        fclose(f);
    }
    return 1;
}

stock CarregarConta(playerid)
{
    new file[64], str[128];
    format(file, sizeof(file), "Contas/%s.ini", NomeConta[playerid]);
    if(!fexist(file)) return 0;

    new File:f = fopen(file, io_read);
    if(f)
    {
        fread(f, str, sizeof(str));
        fclose(f);

        new dados[6][32];
        split_string(str, dados, '|');

        format(SenhaConta[playerid], 32, "%s", dados[0]);
        SkinRP[playerid] = strval(dados[1]);
        IdadeRP[playerid] = strval(dados[2]);
        SexoRP[playerid] = strval(dados[3]);
        AdminLevel[playerid] = strval(dados[4]);
        DinheiroRP[playerid] = strval(dados[5]);
    }
    return 1;
}

stock LoginConta(playerid)
{
    new file[64];
    format(file, sizeof(file), "Contas/%s.ini", NomeConta[playerid]);

    if(!fexist(file))
    {
        SendClientMessage(playerid, COR_ERRO, "Conta nao existe. Crie uma conta!");
        ShowCharacterCreator(playerid);
        return 0;
    }

    CarregarConta(playerid);
    HideLogin(playerid);
    TogglePlayerSpectating(playerid, 0);
    SetSpawnInfo(playerid, 0, SkinRP[playerid], 1682.0, -2330.0, 13.5, 90.0, 0,0,0,0);
    SpawnPlayer(playerid);
    SendClientMessage(playerid, COR_SUCESSO, "Login realizado! Bem-vindo de volta!");

    if(AdminLevel[playerid] > 0)
    {
        new msg[64];
        format(msg, sizeof(msg), "{FF0000}[ADM] Voce logou como Admin Level %d", AdminLevel[playerid]);
        SendClientMessage(playerid, -1, msg);
    }
    return 1;
}

stock RegistrarConta(playerid)
{
    new file[64];
    format(file, sizeof(file), "Contas/%s.ini", NomeConta[playerid]);
    if(fexist(file)) return SendClientMessage(playerid, COR_ERRO, "Conta ja existe. Faca login!");
    if(strlen(SenhaConta[playerid]) < 4) return SendClientMessage(playerid, COR_ERRO, "Digite uma senha primeiro!");

    SalvarConta(playerid);
    SendClientMessage(playerid, COR_SUCESSO, "Conta criada! Configure seu personagem.");
    ShowCharacterCreator(playerid);
    return 1;
}

stock split_string(const str[], dest[][], delimiter)
{
    new i, j, k;
    while(str[i]!= EOS)
    {
        if(str[i] == delimiter)
        {
            dest[j][k] = EOS;
            j++;
            k = 0;
        }
        else
        {
            dest[j][k] = str[i];
            k++;
        }
        i++;
    }
    dest[j][k] = EOS;
}

stock CriarEmpresa(nome[], Float:x, Float:y, Float:z, preco)
{
    if(TotalEmpresas >= 100) return -1;

    EmpresaInfo[TotalEmpresas][empID] = TotalEmpresas;
    EmpresaInfo[TotalEmpresas][empX] = x;
    EmpresaInfo[TotalEmpresas][empY] = y;
    EmpresaInfo[TotalEmpresas][empZ] = z;
    format(EmpresaInfo[TotalEmpresas][empNome], 32, "%s", nome);
    format(EmpresaInfo[TotalEmpresas][empDono], MAX_PLAYER_NAME, "Ninguem");
    EmpresaInfo[TotalEmpresas][empPreco] = preco;
    EmpresaInfo[TotalEmpresas][empCofre] = 0;

    EmpresaInfo[TotalEmpresas][empPickup] = CreatePickup(1274, 1, x, y, z, 0);

    new label[128];
    format(label, sizeof(label), "{8A2BE2}%s\n{FFFFFF}Preco: $%d\nDono: %s", nome, preco, "Ninguem");
    EmpresaInfo[TotalEmpresas][empLabel] = Create3DTextLabel(label, -1, x, y, z+0.5, 10.0, 0, 0);

    TotalEmpresas++;
    SalvarEmpresas();
    return TotalEmpresas-1;
}

stock SalvarEmpresas()
{
    new file[64];
    for(new i = 0; i < TotalEmpresas; i++)
    {
        format(file, sizeof(file), "Empresas/empresa_%d.ini", i);
        if(!DOF2_FileExists(file)) DOF2_CreateFile(file);

        DOF2_SetString(file, "Nome", EmpresaInfo[i][empNome]);
        DOF2_SetFloat(file, "X", EmpresaInfo[i][empX]);
        DOF2_SetFloat(file, "Y", EmpresaInfo[i][empY]);
        DOF2_SetFloat(file, "Z", EmpresaInfo[i][empZ]);
        DOF2_SetString(file, "Dono", EmpresaInfo[i][empDono]);
        DOF2_SetInt(file, "Preco", EmpresaInfo[i][empPreco]);
        DOF2_SetInt(file, "Cofre", EmpresaInfo[i][empCofre]);
        DOF2_SaveFile();
    }
    return 1;
}

stock CarregarEmpresas()
{
    new file[64];
    TotalEmpresas = 0;
    while(TotalEmpresas < 100)
    {
        format(file, sizeof(file), "Empresas/empresa_%d.ini", TotalEmpresas);
        if(!DOF2_FileExists(file)) break;

        EmpresaInfo[TotalEmpresas][empID] = TotalEmpresas;
        DOF2_GetString(file, "Nome", EmpresaInfo[TotalEmpresas][empNome], 32);
        EmpresaInfo[TotalEmpresas][empX] = DOF2_GetFloat(file, "X");
        EmpresaInfo[TotalEmpresas][empY] = DOF2_GetFloat(file, "Y");
        EmpresaInfo[TotalEmpresas][empZ] = DOF2_GetFloat(file, "Z");
        DOF2_GetString(file, "Dono", EmpresaInfo[TotalEmpresas][empDono], MAX_PLAYER_NAME);
        EmpresaInfo[TotalEmpresas][empPreco] = DOF2_GetInt(file, "Preco");
        EmpresaInfo[TotalEmpresas][empCofre] = DOF2_GetInt(file, "Cofre");

        EmpresaInfo[TotalEmpresas][empPickup] = CreatePickup(1274, 1, EmpresaInfo[TotalEmpresas][empX], EmpresaInfo[TotalEmpresas][empY], EmpresaInfo[TotalEmpresas][empZ], 0);

        new label[128];
        format(label, sizeof(label), "{8A2BE2}%s\n{FFFFFF}Preco: $%d\nDono: %s", EmpresaInfo[TotalEmpresas][empNome], EmpresaInfo[TotalEmpresas][empPreco], EmpresaInfo[TotalEmpresas][empDono]);
        EmpresaInfo[TotalEmpresas][empLabel] = Create3DTextLabel(label, -1, EmpresaInfo[TotalEmpresas][empX], EmpresaInfo[TotalEmpresas][empY], EmpresaInfo[TotalEmpresas][empZ]+0.5, 10.0, 0, 0);

        TotalEmpresas++;
    }
    printf("[EMPRESAS] Carregadas: %d", TotalEmpresas);
    return 1;
}

